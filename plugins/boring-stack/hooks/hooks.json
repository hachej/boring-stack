{
  "hooks": {
    "UserPromptExpansion": [
      { "matcher": "^(boring-stack:)?boring-mode$", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" loaded" } ] }
    ],
    "SubagentStart": [
      { "matcher": "^boring-stack:builder$", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" loaded" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Skill|Read|Bash", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" post" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|NotebookEdit|Bash", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" pre" } ] }
    ]
  }
}
