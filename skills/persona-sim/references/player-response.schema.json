{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private player response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "done", "stopReason", "selfReport"],
  "properties": {
    "message": { "type": "string" },
    "done": { "type": "boolean" },
    "stopReason": {
      "enum": ["continue", "goal_reached", "gave_up", "turn_limit"]
    },
    "selfReport": {
      "anyOf": [
        { "$ref": "self-report.schema.json" },
        { "type": "null" }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "message": { "minLength": 1, "pattern": "\\S" },
        "done": { "const": false },
        "stopReason": { "const": "continue" },
        "selfReport": { "type": "null" }
      }
    },
    {
      "properties": {
        "done": { "const": true },
        "stopReason": { "enum": ["goal_reached", "gave_up", "turn_limit"] },
        "selfReport": { "$ref": "self-report.schema.json" }
      }
    }
  ]
}
